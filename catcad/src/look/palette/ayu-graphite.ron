    sheet_side:   "#dc4b34",  // ansi_red               red_450
    sheet_datum:  "#747474",  // line_number            gray_600
    mark:         "#d897ff",  // syn_number             purple_400
    redundant:    "#ffa493",  // ansi_bright_red        red_250
    depth_arrow:  "#dfdfdf",  // selection_fg           gray_200

    // Lighting — what singling something out looks like.
