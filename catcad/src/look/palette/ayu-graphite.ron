    sheet_side:   "#c33b26",  // ansi_red            red_normal
    sheet_datum:  "#515151",  // line_number         gray_44
    mark:         "#c698e2",  // syn_number          magenta_bright
    redundant:    "#fd8974",  // ansi_bright_red     red_bright
