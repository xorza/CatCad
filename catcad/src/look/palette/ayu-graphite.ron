// Source:    ayu-graphite.toml
// Generator: ayu-graphite/catcad/build.py
//
// Each entry names a role CatCad draws with, the role here it is taken
// from, and the primitive that resolves to. Neutrals were re-emitted at
// the grey of the same relative luminance. Hues passed through: a hue
// says something in a drawing, and a shifted one would say it about a
// different colour.
(
    // Chrome — the surfaces and inks a control floating over the drawing wears.
    ground:       "#1f1f1f",  // bg                 gray_1
    pill:         "#2b2b2b",  // panel              gray_2
    pill_edge:    "#ebebeb",  // text               gray_7
    rule:         "#ebebeb",  // text               gray_7
    chip:         "#383838",  // elem               gray_3
    chip_lit:     "#454545",  // elem_hover         gray_4
    chip_active:  "#525252",  // elem_active        gray_5
    chip_held:    "#ebebeb",  // text               gray_7
    on_held:      "#1f1f1f",  // bg                 gray_1
    ink:          "#a4a4a4",  // text_muted         gray_6
    ink_lit:      "#ebebeb",  // text               gray_7
    ink_dim:      "#6b6b6b",  // (the ramp's gap)   between gray_5 and gray_6
    cube_low:     "#2b2b2b",  // panel              gray_2
    cube_high:    "#525252",  // line_number        gray_5
    focus:        "#ebebeb",  // text               gray_7

    // Drawing — what the geometry and the solids beside it are painted in.
    solid:        "#ebebeb",  // line_number_hover  gray_7
    determined:   "#74c3f7",  // syn_type           blue_bright
    partly:       "#fbdd89",  // warning            yellow_bright
    free:         "#f8b065",  // syn_keyword        orange_bright
    pinned:       "#f77f71",  // error              red_bright
    dormant:      "#a4a4a4",  // text_muted         gray_6
    dormant_face: "#003e5d",  // info_bg            blue_dim
    face:         "#74c3f7",  // info_border        blue_bright
    ghost:        "#ebebeb",  // text               gray_7
    sheet_ground: "#6cea4e",  // ansi_green         green_bright
    sheet_front:  "#74c3f7",  // ansi_blue          blue_bright
    sheet_side:   "#f77f71",  // ansi_red           red_bright
    sheet_datum:  "#525252",  // line_number        gray_5
    mark:         "#a4a4a4",  // text_muted         gray_6
    redundant:    "#f77f71",  // ansi_bright_red    red_bright
    depth_arrow:  "#ebebeb",  // selection_fg       gray_7

    // Lighting — what singling something out looks like.
    hovered:      "#ffffff",  // ansi_bright_white  white
    selected:     "#6cea4e",  // success            green_bright

    // Form — the answers a prompt standing on the drawing offers.
    goes:         "#6cea4e",  // success_border     green_bright
    stops:        "#f77f71",  // error_border       red_bright
    doing:        "#74c3f7",  // info_border        blue_bright
)
