    chip_active:  "#474747",  // elem_active            gray_750
    chip_held:    "#dfdfdf",  // text                   gray_200
    on_held:      "#1e1e1e",  // bg                     gray_950
    ink:          "#aaaaaa",  // text_muted             gray_400
    ink_lit:      "#dfdfdf",  // text                   gray_200
    ink_dim:      "#565656",  // (the ramp's gap)       between gray_750 and gray_600
    cube_low:     "#272727",  // panel                  gray_900
    cube_high:    "#747474",  // line_number            gray_600
    focus:        "#dfdfdf",  // text                   gray_200

    // Drawing — what the geometry and the solids beside it are painted in.
    solid:        "#c6c6c6",  // line_number_hover      gray_300
    determined:   "#7adcf3",  // syn_type               cyan_400
    partly:       "#ffd44a",  // warning                yellow_400
    free:         "#ffa63d",  // syn_keyword            orange_400
    pinned:       "#ff6b52",  // error                  red_400
    dormant:      "#aaaaaa",  // text_muted             gray_400
